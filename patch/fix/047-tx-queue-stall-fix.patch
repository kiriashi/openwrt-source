+/*
+ * Per-band pending dequeue request bit ops.  tx_deq_pending is a per-queue
+ * bitmap indexed by band_idx: the fp dequeue arm path sets a bit when it bails
+ * on the per-band token limit, and the token-free / arm-recovery path (see
+ * token_tx_wake_deq_if_recovered()) tests + clears + reschedules TX_DEQ_TASK
+ * once the band usage recovers.  The pending bit is intentionally NOT cleared
+ * on the dequeue success path: a concurrent tasklet could be about to observe
+ * it for a recovery crossing, and a clear-without-schedule there would lose
+ * that wakeup.  It is consumed only by token_tx_wake_deq_if_recovered(),
+ * which clears it exactly when it schedules, so leaving it set until recovery
+ * is correct and self-cleaning.
+ *
+ * set/clear_bit are relaxed atomic ops; the plain test used by the wake and
+ * arm sides is intentional -- the closed-window protocol lives in
+ * token_tx_wake_deq_if_recovered() (armed side re-checks right after setting,
+ * free side checks right after decrementing, only one side wins the
+ * clear+schedule), and that function orders both sides with an smp_mb().
+ *
+ * The band_idx width guard is defensive: band_idx is constrained to 0/1 by
+ * the whole call chain today (TOKEN_DEQ_PENDING_NBAND bands, matching the
+ * [2]-sized per-band counter arrays), but an out-of-range index would
+ * otherwise make the kernel bitops write past the ULONG bitmap.
+ */
+#define TOKEN_DEQ_PENDING_NBAND 2
+
+static inline VOID token_tx_set_deq_pending(struct token_tx_pkt_queue *que,
+						UINT32 band_idx)
+{
+	if (band_idx >= TOKEN_DEQ_PENDING_NBAND)
+		return;
+	set_bit(band_idx, &que->tx_deq_pending);
+}
+
+static inline VOID token_tx_clear_deq_pending(struct token_tx_pkt_queue *que,
+						UINT32 band_idx)
+{
+	if (band_idx >= TOKEN_DEQ_PENDING_NBAND)
+		return;
+	clear_bit(band_idx, &que->tx_deq_pending);
+}
+
+static inline BOOLEAN token_tx_test_deq_pending(struct token_tx_pkt_queue *que,
+						UINT32 band_idx)
+{
+	if (band_idx >= TOKEN_DEQ_PENDING_NBAND)
+		return FALSE;
+	return test_bit(band_idx, &que->tx_deq_pending);
+}
