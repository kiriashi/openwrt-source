+/*
+ * Wake the TX dequeue task for one band once its per-band token usage has
+ * recovered.  Shared by the token-free path (token_tx_deq()) and the fp
+ * dequeue arm path (fp_tx_pkt_deq_func()/fp_fair_tx_pkt_deq_func()): whoever
+ * observes "pending set && band usage <= high watermark" performs the
+ * clear+schedule, which closes the lost-wakeup window between the dequeue's
+ * set_bit() and a concurrent TX-done's test_bit() -- at least one of the two
+ * sides always sees the recovery.
+ *
+ * The !token_tx_get_state() filter intentionally excludes the global-token-low
+ * blocking source (TX_TOKEN_LOW), which the legacy TX-free wake machinery
+ * already handles with its own hysteresis; this channel fires only for the
+ * per-band recovery it was introduced to cover.  schedule_task() is a tasklet
+ * schedule and does not sleep, so this may run in IRQ/BH context (the
+ * token_tx_deq() caller already holds que->deq_lock there, matching the
+ * existing pattern).
+ *
+ * Memory-ordering: on weakly-ordered cores (ARM64/MT7986) the two-sided
+ * arm/recheck protocol needs a happens-before edge between each side's
+ * state change (arm side's set_bit, free side's atomic_dec) and its
+ * subsequent checks.  The smp_mb() below orders the caller's preceding
+ * state change against the pending test and the usage reads, closing the
+ * Dekker-style window where both sides could otherwise observe the stale
+ * pre-change state and skip the wake.  The arm side calls this without any
+ * lock (taking que->deq_lock there would invert the lock order against
+ * tr_entry->txq_lock in the FAIR data phase), so the barrier is the whole
+ * synchronization; the free side additionally serializes under que->deq_lock.
+ */
+VOID token_tx_wake_deq_if_recovered(
+	RTMP_ADAPTER *pAd, struct token_tx_pkt_queue *que, UINT32 band_idx)
+{
+	struct tm_ops *tm_ops = pAd->tm_qm_ops;
+	RTMP_CHIP_CAP *cap = hc_get_chip_cap(pAd->hdev_ctrl);
+
+	/* Defensive: the real band domain is TOKEN_DEQ_PENDING_NBAND bands; the
+	 * per-band counter arrays are [TOKEN_DEQ_PENDING_NBAND]-sized. */
+	if (band_idx >= TOKEN_DEQ_PENDING_NBAND)
+		return;
+
+	smp_mb();
+
+	if (token_tx_test_deq_pending(que, band_idx) &&
+	    !token_tx_get_state(que) &&
+	    (token_tx_get_used_cnt_per_band(que, band_idx)
+	     <= token_tx_get_hwmark_per_band(que, band_idx))) {
+		token_tx_clear_deq_pending(que, band_idx);
+		tm_ops->schedule_task(pAd, TX_DEQ_TASK,
+			cap->multi_token_ques_per_band ? band_idx : 0);
+	}
+}
